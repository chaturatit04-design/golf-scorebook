rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isMember(code) {
      return request.auth != null
        && exists(/databases/$(database)/documents/groups/$(code)/members/$(request.auth.uid));
    }
    function groupOf(code) {
      return get(/databases/$(database)/documents/groups/$(code)).data;
    }
    function isOwner(code) {
      return request.auth != null && groupOf(code).owner == request.auth.uid;
    }
    function isOpen(code) {
      return groupOf(code).get('archived', false) != true;
    }
    // an abandoned room: not finished, not archived, nothing entered for a day
    function abandoned(g) {
      return g.get('ended', false) != true
        && g.get('archived', false) != true
        && g.get('thru', 0) < g.get('holes', 18)
        && g.get('createdAt', 0) < request.time.toMillis() - 86400000
        && (g.get('last', null) == null || g.last < request.time - duration.value(1, 'd'));
    }
    function canPurge(code) {
      return isMember(code) && abandoned(groupOf(code));
    }

    match /groups/{code} {
      allow get: if true;
      allow list: if false;
      allow create: if request.auth != null
        && request.resource.data.owner == request.auth.uid;
      allow update: if request.auth != null && (
        (resource.data.owner == request.auth.uid
          && request.resource.data.owner == resource.data.owner)
        || (isMember(code)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['last','thru'])
          && request.resource.data.last == request.time));
      allow delete: if request.auth != null
        && (resource.data.owner == request.auth.uid || (isMember(code) && abandoned(resource.data)));

      match /scores/{pid} {
        allow read: if true;
        allow create, update: if isMember(code) && isOpen(code);
        allow delete: if isOwner(code) || canPurge(code);
      }

      match /members/{uid} {
        allow read: if request.auth != null && (request.auth.uid == uid || isOwner(code));
        allow delete: if (request.auth != null && request.auth.uid == uid) || isOwner(code) || canPurge(code);
        allow create: if request.auth != null && request.auth.uid == uid
          && request.resource.data.k ==
             get(/databases/$(database)/documents/groupKeys/$(code)).data.k;
      }

      match /chat/{mid} {
        allow read: if true;
        allow create: if request.auth != null
          && request.resource.data.keys().hasOnly(['uid','name','role','text','at'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() >= 1
          && request.resource.data.text.size() <= 200
          && request.resource.data.name is string
          && request.resource.data.name.size() >= 1
          && request.resource.data.name.size() <= 30
          && request.resource.data.at == request.time
          && (request.resource.data.role == 'v'
              || (request.resource.data.role == 'p' && isMember(code)))
          && groupOf(code).get('chatLocked', false) != true
          && isOpen(code);
        allow delete: if request.auth != null
          && (resource.data.uid == request.auth.uid
              || groupOf(code).owner == request.auth.uid
              || canPurge(code));
      }

      // guesses at the winner: one per device, open until hole 1 is done
      match /picks/{uid} {
        allow read: if true;
        allow create, update: if request.auth != null && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['p','name','at'])
          && request.resource.data.p is string && request.resource.data.p.size() <= 10
          && request.resource.data.name is string
          && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 30
          && request.resource.data.at == request.time
          && groupOf(code).get('thru', 0) <= 1
          && groupOf(code).get('ended', false) != true
          && isOpen(code);
        allow delete: if (request.auth != null && request.auth.uid == uid) || isOwner(code) || canPurge(code);
      }

      match /watch/{uid} {
        allow read: if true;
        allow create, update: if request.auth != null && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['at','exp'])
          && request.resource.data.at == request.time;
        allow delete: if (request.auth != null && request.auth.uid == uid) || isOwner(code) || canPurge(code);
      }
    }

    match /groupKeys/{code} {
      allow read: if false;
      allow create: if isOwner(code);
      allow delete: if isOwner(code) || canPurge(code);
    }

    match /live/{code} {
      allow read: if true;
      allow create, update: if isMember(code)
        && groupOf(code).get('public', false) == true
        && isOpen(code)
        && request.resource.data.keys().hasOnly(['course','date','n','thru','ended','lead','leadPar','last','exp'])
        && request.resource.data.last == request.time;
      allow delete: if request.auth != null
        && (groupOf(code).owner == request.auth.uid || canPurge(code));
    }

    match /events/{id} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.cap >= 2 && request.resource.data.cap <= 10
        && request.resource.data.seats.size() <= 1;
      allow update: if request.auth != null && (
        (resource.data.owner == request.auth.uid
          && request.resource.data.owner == resource.data.owner
          && request.resource.data.cap >= 2 && request.resource.data.cap <= 10)
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seats'])
          && request.resource.data.seats.diff(resource.data.seats).affectedKeys().hasOnly([request.auth.uid])
          && request.resource.data.seats.size() <= resource.data.cap
          && resource.data.status == 'open'
          && request.time.toMillis() >= resource.data.openAt
          && request.time.toMillis() < resource.data.closeAt
          && (!(request.auth.uid in request.resource.data.seats)
              || (request.resource.data.seats[request.auth.uid].name is string
                  && request.resource.data.seats[request.auth.uid].name.size() <= 40)))
      );
      allow delete: if request.auth != null && resource.data.owner == request.auth.uid;
    }
  }
}
